# Polymarket API Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Paper Trading Mode ---
# Set to "true" to run in simulation mode (no real money)
PAPER_TRADING=true

# --- Polymarket CLOB API ---
# Base URL for the Gamma CLOB REST API (public, no auth needed for reads)
CLOB_API_BASE_URL=https://clob.polymarket.com

# --- Gamma Markets API ---
# Base URL for market data (public)
GAMMA_API_BASE_URL=https://gamma-api.polymarket.com

# --- Data API ---
# Base URL for positions/trades/activity (public)
DATA_API_BASE_URL=https://data-api.polymarket.com

# --- Authentication (only needed for placing orders) ---
# Leave empty for paper trading / read-only mode
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# --- Bot Configuration ---
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Request timeout in seconds
REQUEST_TIMEOUT=10

# Max retries for failed requests
MAX_RETRIES=3
